#-----------------------------------(decals)---------------------------

[decal_trophyOverlay]
isVisible:if self.resource(type='Trophy', greaterThan=0)
imageStack:ROOT:data\images\trophyMarker.png, ROOT:data\images\trophy.png
imageScale: 0.45
hOffset:12
stack_hOffset:0
onlyTeam:own
alwaysStartDirAtZero: true
xOffsetRelative: 0
yOffsetRelative: 0
basePosition: self
layer: beforeUI
alpha: 0.85
onlyWhileAlive: true
onlyWithZoomLevelOrMore: 0.5

[decal_trophyLvl1]
@copyFromSection: decal_trophyOverlay
imageStack:ROOT:data\images\trophyLvl1.png
isVisible:if self.resource(type='TrophyLevel', greaterThan=0)
[decal_trophyLvl2]
