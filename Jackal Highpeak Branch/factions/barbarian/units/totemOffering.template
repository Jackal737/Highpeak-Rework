[hiddenAction_trophyGetValue]
autoTriggerOnEvent:newMessage(withTag='trophy')
setResourcesWithLogic:trophySize=EventData("trophyValue", type="float")
alsoTriggerAction:trophySetValue

[hiddenAction_trophySetValue]
setResourcesWithLogic:trophyValue=self.resource.trophySize
requireConditional:if self.resource.trophySize >= self.resource.trophyValue
alsoTriggerAction:trophySetLevel1, trophySetLevel2, trophySetLevel3

[hiddenAction_resetTrophyValue]
setResourcesWithLogic:trophySize=0,trophyValue=0, trophyLevel=0

[hiddenAction_trophySetLevel1]
setResourcesWithLogic:trophyLevel=1
requireConditional:if self.resource.trophyValue <= 50
[hiddenAction_trophySetLevel2]
setResourcesWithLogic:trophyLevel=2
requireConditional:if self.resource.trophyValue >= 50 and self.resource.trophyValue <= 100
[hiddenAction_trophySetLevel3]
setResourcesWithLogic:trophyLevel=3
requireConditional:if self.resource.trophyValue >= 100

[action_wolf]
alsoTriggerAction:resetTrophyValue
spawnEffectsOnQueue:CUSTOM:wolfHowl
isVisible: if ((numberOfUnitsInTeam(withTag='hunterTotem', withinRange=110, greaterThan=0) or self.numberOfUnitsInAllyNotOwnTeam(withTag='hunterTotem', withinRange=110, greaterThan=0))and not self.tags(includes='elite')) or self.isControlledByAI()
isLocked: if self.isControlledByAI() and self.tags(includes='elite')
isLockedAlt: if self.isControlledByAI() and self.kills(lessThan=4) 
unitShownInUI:highpeakBarbarianInfantry_4
convertTo:highpeakBarbarianInfantry_4
addResources: hp=1000
displayType: upgrade
price:  trophy=1, trophyLevel=1, Gazul=100
text: Honor the wolf spirit
description:-Use your trophy to honor this spirit\n -Be reborn as an animal warrior\n -Good vs infantry\n -Stealthy\n -Super vision\n -fast\n -Raider
buildSpeed: 0s
pos:1
[effect_wolfHowl]
alsoEmitEffects: CUSTOM:upgrade
alsoPlaySound:ROOT:\data\soundFx\wolfHowl.ogg:0.25

